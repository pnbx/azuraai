# AzuraAI Environment Variables
# Copy this file to .env.local and fill in the values.

# ─── Supabase (Required) ──────────────────────────────────────────────────────
# Your Supabase project URL (public, safe for browser)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here

# Your Supabase anonymous/public key (public, safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Your Supabase service role key (SERVER-ONLY, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Provider API Keys (Server-Only) ──────────────────────────────────────────
# Inference provider API key (required for inference)
AVALAI_API_KEY=your_avali_api_key_here

# AvalAI API base URL (default: https://api.avalai.ir/v1)
AVALAI_BASE_URL=https://api.avalai.ir/v1

# ─── Payment Provider (Server-Only) ──────────────────────────────────────────
# ZarinPal merchant ID (required for payments in production)
# Get yours at: https://merchant.zarinpal.com/
ZARINPAL_MERCHANT_ID=your_zarinpal_merchant_id_here

# Set to "true" to use ZarinPal sandbox for testing
# In production, omit this or set to "false"
ZARINPAL_SANDBOX=true

# Callback URL for ZarinPal redirects after payment
# Must match the URL configured in your ZarinPal merchant panel
# Example: https://yourdomain.com/api/payments/callback/zarinpal
# ZARINPAL_CALLBACK_URL=https://yourdomain.com/api/payments/callback/zarinpal

# ─── Site Configuration ──────────────────────────────────────────────────────
# Public site URL (used for payment callbacks if ZARINPAL_CALLBACK_URL is not set)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── App Free Gateway (OpenRouter) — SERVER-ONLY, comma-separated key pool ───
# Free models: 20 req/min and 50 req/day per key. The pool rotates keys and
# fails over automatically. Add as many keys as you have.
# OPENROUTER_KEYS=sk-or-v1-xxx,sk-or-v1-yyy,sk-or-v1-zzz

# Model routing (OpenRouter free model slugs)
OPENROUTER_MODEL_FAST=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_MODEL_THINKING=deepseek/deepseek-r1:free
OPENROUTER_MODEL_RESEARCH=deepseek/deepseek-chat-v3-0324:free

# Free-tier daily message caps. The app has no accounts, so both apply:
# APP_CHAT_DAILY_CAP is charged against the account when someone is signed in,
# APP_CHAT_GUEST_DAILY_CAP against an anonymous device. Guests are deliberately
# lower so that signing in is worth something.
APP_CHAT_DAILY_CAP=30
APP_CHAT_GUEST_DAILY_CAP=10

# Salt for the anonymous guest quota key (SERVER-ONLY).
# The client sends a random device UUID; this hashes it before it is stored,
# so the database never holds anything that identifies a device. Rotating this
# value resets every guest counter and invalidates the old rows.
# Must be unique per environment - never reuse the dev value in production.
APP_GUEST_ID_PEPPER=change-me-to-a-long-random-string

# ─── Research mode (Tavily search) — SERVER-ONLY ────────────────────────────
# Free tier: ~1,000 searches/month. Get a key at https://tavily.com
# TAVILY_API_KEY=

# ─── Google Integrations (Gmail/Calendar) — SERVER-ONLY ─────────────────────
# Google Cloud OAuth client (Web application). Redirect URI:
#   https://www.azuraai.ir/api/app/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
