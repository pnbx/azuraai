# AzuraAI Environment Variables
# Copy this file to .env.local and fill in the values.

# ─── Supabase (Required) ──────────────────────────────────────────────────────
# Your Supabase project URL (public, safe for browser)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here

# Your Supabase anonymous/public key (public, safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Your Supabase service role key (SERVER-ONLY, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Provider API Keys (Server-Only) ──────────────────────────────────────────
# AvalAI provider API key (required for inference)
AVALAI_API_KEY=your_avali_api_key_here
