<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Match the web app's surface so there is never a white flash
             between the system splash and the first painted WebView frame. -->
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!--
        Launch theme.

        Deliberately a plain theme rather than Theme.SplashScreen: the androidx
        splash API only swaps themes when installSplashScreen() is called, and
        if it isn't the activity keeps the splash theme's default WHITE window
        background for its whole life — which is exactly the flash we saw.

        Instead the window background is our own zinc plate with the mark
        centred, so every Android version shows branded pixels from the first
        frame, and AzuraSplashView animates on top of it.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>